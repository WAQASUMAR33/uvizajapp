generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  SALESMAN
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MerchantCategory {
  CASUAL_DINING
  PREMIUM_DINING
  CAFES
  BRUNCH
  BARS_NIGHTLIFE
}

// ─── Admin auth (NextAuth) & Roles ────────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?  @db.Text
  permissions String   @db.Text
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(191)
  password      String?   @db.VarChar(191)
  name          String?   @db.VarChar(191)
  image         String?   @db.VarChar(191)
  role          UserRole  @default(ADMIN)
  roleId        Int?
  permissions   String?   @db.Text
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customRole Role?    @relation(fields: [roleId], references: [id])
  accounts   Account[]
  sessions   Session[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String  @db.VarChar(191)
  provider          String  @db.VarChar(100)
  providerAccountId String  @db.VarChar(100)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(191)
  scope             String? @db.VarChar(191)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(191)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @db.VarChar(191)
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String   @db.VarChar(100)
  token      String   @unique @db.VarChar(100)
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Customer (app users / subscribers) ──────────────────────────────────────

model Customer {
  id          Int       @id @default(autoincrement())
  fullname    String    @db.VarChar(191)
  email       String    @unique @db.VarChar(191)
  password    String?   @db.VarChar(191)
  uid         String?   @unique @db.VarChar(191)
  logType     String    @default("email") @db.VarChar(50)
  phoneNumber String?   @db.VarChar(50)
  nationality String?   @db.VarChar(100)
  dateOfBirth DateTime?
  gender      String?   @db.VarChar(20)
  imageUrl    String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subscription    Subscription?
  redemptions     Redemption[]
  merchantRatings MerchantRating[]
}

// ─── Business models ──────────────────────────────────────────────────────────

model Subscription {
  id                    Int                  @id @default(autoincrement())
  customerId            Int                  @unique
  subscriptionPackageId Int?
  promoCodeId           Int?
  promoCode             String?              @db.VarChar(50)
  discountAmount        Float                @default(0)
  plan                  SubscriptionPlan     @default(ANNUAL)
  status                SubscriptionStatus   @default(ACTIVE)
  startDate             DateTime             @default(now())
  endDate               DateTime
  price                 Float
  currency              String               @default("EUR")
  paymentRef            String?
  platform              String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  customer             Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  subscriptionPackage  SubscriptionPackage?  @relation(fields: [subscriptionPackageId], references: [id])
  promoCodeRecord      PromoCode?            @relation(fields: [promoCodeId], references: [id])
}

model Category {
  id            Int      @id @default(autoincrement())
  nameEn        String
  nameHr        String
  slug          String   @unique
  emoji         String   @default("🍽️")
  image         String?  @db.VarChar(500)
  descriptionEn String?  @db.Text
  descriptionHr String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Merchant {
  id              Int              @id @default(autoincrement())
  merchantCode    String?          @unique @db.VarChar(4)
  nameEn          String
  nameHr          String
  descriptionEn   String?          @db.Text
  descriptionHr   String?          @db.Text
  category        MerchantCategory @default(CASUAL_DINING)
  addressEn       String?
  addressHr       String?
  cityEn          String?
  cityHr          String?
  latitude        Float?
  longitude       Float?
  phone           String?
  website         String?
  images          String?          @db.Text
  isActive        Boolean          @default(true)
  savingsEstimate Float            @default(0)
  avgRating       Float            @default(0)
  ratingCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  offers      Offer[]
  redemptions Redemption[]
  ratings     MerchantRating[]
}

model Offer {
  id            Int       @id @default(autoincrement())
  merchantId    Int
  titleEn       String
  titleHr       String
  descriptionEn String?   @db.Text
  descriptionHr String?   @db.Text
  discountEn    String?
  discountHr    String?
  discountValue Float?
  offerAmount   Float?
  termsEn       String?   @db.Text
  termsHr       String?   @db.Text
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  merchant    Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  redemptions Redemption[]
}

model SubscriptionPackage {
  id            Int            @id @default(autoincrement())
  titleEn       String         @db.VarChar(191)
  titleHr       String         @db.VarChar(191)
  priceMonthly  Float
  priceYearly   Float
  discountValue Float?
  descriptionEn String?        @db.Text
  descriptionHr String?        @db.Text
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model MerchantRating {
  id         Int      @id @default(autoincrement())
  customerId Int
  merchantId Int
  rating     Int      // 1–5
  review     String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  @@unique([customerId, merchantId])
}

model Redemption {
  id              Int      @id @default(autoincrement())
  customerId      Int
  offerId         Int
  merchantId      Int
  offerAmount     Float?
  offerDiscountEn String?
  offerDiscountHr String?
  savings         Float    @default(0)
  redeemedAt      DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  offer    Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model TermsAndConditions {
  id        Int      @id @default(autoincrement())
  contentEn String   @db.LongText
  contentHr String   @db.LongText
  updatedAt DateTime @updatedAt
}

model PromoCode {
  id                Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(50)
  titleEn           String?   @db.VarChar(191)
  titleHr           String?   @db.VarChar(191)
  discountType      String    @default("PERCENTAGE") @db.VarChar(20)
  discountValue     Float
  minOrderAmount    Float     @default(0)
  maxDiscountAmount Float?
  maxUses           Int?
  usedCount         Int       @default(0)
  validFrom         DateTime  @default(now())
  validUntil        DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  subscriptions Subscription[]
}
